# Configurações do Supabase para Produção e Desenvolvimento Local
# Substitua com suas credenciais do projeto no Supabase (Dashboard -> Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# ATENÇÃO: NUNCA exponha a SERVICE_ROLE_KEY no navegador ou no código do repositório!
# SUPABASE_SERVICE_ROLE_KEY=apenas-para-scripts-de-administracao-no-servidor
